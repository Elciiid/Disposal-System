{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "pages/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "api/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "auth/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "styles/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(assets|styles)/(.*)",
      "dest": "/$1/$2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.php"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/auth/$1.php"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/pages/$1.php"
    },
    {
      "src": "/([^/]+\\.php)$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}