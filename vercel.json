{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.6.0" },
    "pages/*.php": { "runtime": "vercel-php@0.6.0" },
    "auth/*.php": { "runtime": "vercel-php@0.6.0" },
    "index.php": { "runtime": "vercel-php@0.6.0" },
    "test_connection.php": { "runtime": "vercel-php@0.6.0" }
  },
  "routes": [
    {
      "src": "/(assets|styles)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.php"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/auth/$1.php"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/pages/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}